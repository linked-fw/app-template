# App environment for local (standalone) dev.
#
# `linked start` loads this file natively via Node's `process.loadEnvFile` — no
# dependency. `.env` is gitignored; `npm install` (and `npm start`/`npm run build`)
# copy this example to `.env` when it is missing (scripts/ensure-env.cjs), so a
# fresh clone just works.
# In production the host REPLACES `.env` or injects these as real environment
# variables — the shell environment always wins over values in the file.
#
# A host that runs this app may inject per-deployment vars (PORT,
# FUSEKI_DATASET, ...) at spawn time; those take precedence over anything here.

# --- App identity -------------------------------------------------------------
APP_NAME=Linked App Template
APP_PREFIX=app
DATA_ROOT=http://localhost:4000/data

# --- Runtime ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
SITE_ROOT=http://localhost:4000
SOURCE_PATH=./src

# --- Data store (standalone-dev defaults; a host may inject its own) ----------
# These are what the main alias uses by default: linked.backend.datasets.json makes it a
# FusekiStore on ${FUSEKI_BASE_URL}/${FUSEKI_DATASET}, logging in as
# FUSEKI_USER/FUSEKI_PASSWORD. When a host such as Create Now switches main to
# a RemoteDataset, these are unused and DATA_SERVER_URL/DATA_SERVER_TOKEN_MAIN
# (below) are used instead.
FUSEKI_BASE_URL=http://localhost:3030
FUSEKI_DATASET=app-main
FUSEKI_USER=admin
FUSEKI_PASSWORD=admin
# Create the dataset above on boot when absent (unset = yes). A host that
# provisions it sets 0, so a lost dataset is reported rather than re-created empty.
LINKED_DATASET_ENSURE=

# --- Data server --------------------------------------------------------------
# Read only when linked.backend.datasets.json points a slot (an alias such as
# main) at a RemoteDataset: DATA_SERVER_URL is the data server's base URL,
# shared by every slot, and DATA_SERVER_TOKEN_<SLOT> the token it issued to this
# app for that slot (the slot in upper case: main → DATA_SERVER_TOKEN_MAIN).
# Unused with the default FusekiStore.
